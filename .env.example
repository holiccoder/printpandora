APP_NAME=InkPavo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8080
VITE_PORT=5173

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240
MEDIA_QUEUE_CONNECTION=database
MEDIA_QUEUE=default
QUEUE_CONVERSIONS_BY_DEFAULT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — dev: "log" (writes to storage/logs/laravel.log)
#        prod: "smtp" + fill DirectMail credentials below
# Docs: https://help.aliyun.com/document_detail/29442.html
MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@inkpavo.com"
MAIL_FROM_NAME="${APP_NAME}"

# DirectMail (Aliyun) — required when MAIL_MAILER=smtp in production
# MAIL_SCHEME=smtps
# MAIL_HOST=smtpdm.aliyun.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Imported shipping rates for the semi-automatic checkout flow. Country rates
# are loaded from the 4PX QC and DHL rate tables in config/shipping.php.
# DHL is created manually in EShip after payment.
SHIPPING_CURRENCY=USD
SHIPPING_DEFAULT_METHOD=standard
SHIPPING_DEFAULT_COUNTRY=US
SHIPPING_RATE_BASIS_WEIGHT_KG=1
SHIPPING_PACKAGE_WEIGHT_GRAMS=250
# 1 RMB = 0.14 USD; update this accounting rate when needed.
SHIPPING_RMB_TO_USD_RATE=0.14
# Legacy 1 kg RMB fallback for countries without a configured tier table.
SHIPPING_STANDARD_RATE=142
SHIPPING_STANDARD_LABEL="Standard Shipping"
SHIPPING_STANDARD_CARRIER="4PX"
SHIPPING_STANDARD_DESCRIPTION="4PX tracked delivery. Shipment is created after payment."
SHIPPING_STANDARD_ESTIMATE="7 - 12 business days"
SHIPPING_STANDARD_MAX_BUSINESS_DAYS=12
SHIPPING_DHL_RATE=201
SHIPPING_DHL_LABEL="Fast Shipping (DHL Express)"
SHIPPING_DHL_DESCRIPTION="Fast tracked delivery. DHL shipment will be created manually after payment."
SHIPPING_DHL_ESTIMATE="2 - 5 business days"
SHIPPING_DHL_MAX_BUSINESS_DAYS=5

# 4PX standard shipping (semi-automatic fulfillment).
# Keep credentials private. Set FOURPX_ENABLED=true only after the test account
# and the logistics product code have been approved by 4PX.
FOURPX_ENABLED=false
FOURPX_ENVIRONMENT=test
FOURPX_APP_KEY=
FOURPX_APP_SECRET=
FOURPX_ACCESS_TOKEN=
FOURPX_LANGUAGE=en
FOURPX_LOGISTICS_PRODUCT_CODE=
FOURPX_ORDER_VERSION=1.1
FOURPX_QUERY_VERSION=1.1
FOURPX_LABEL_VERSION=1.1
FOURPX_TRACKING_VERSION=1.0
FOURPX_REFERENCE_PREFIX=PRINTPANDORA-
FOURPX_BUSINESS_TYPE=BDS
FOURPX_DUTY_TYPE=U
FOURPX_CARGO_TYPE=5
FOURPX_CUSTOMS_SERVICE=N
FOURPX_SIGNATURE_SERVICE=N
FOURPX_VALUE_ADDED_SERVICES=
FOURPX_INCLUDE_BATTERY=N
FOURPX_BATTERY_TYPE=
FOURPX_DECLARE_CURRENCY=USD
FOURPX_ORIGIN_COUNTRY=CN
# These values can be entered on each order in the admin panel instead.
FOURPX_DEFAULT_WEIGHT_GRAMS=
FOURPX_DEFAULT_LENGTH_CM=
FOURPX_DEFAULT_WIDTH_CM=
FOURPX_DEFAULT_HEIGHT_CM=
FOURPX_DELIVER_TYPE=3
FOURPX_WAREHOUSE_CODE=
FOURPX_RETURN_DOMESTIC=N
FOURPX_RETURN_OVERSEAS=N
FOURPX_REQUEST_LABEL=false
FOURPX_TRACKING_URL_TEMPLATE=
FOURPX_TIMEOUT=30
FOURPX_SENDER_FIRST_NAME=
FOURPX_SENDER_LAST_NAME=
FOURPX_SENDER_COMPANY=
FOURPX_SENDER_PHONE=
FOURPX_SENDER_EMAIL=
FOURPX_SENDER_POST_CODE=
FOURPX_SENDER_COUNTRY=CN
FOURPX_SENDER_STATE=
FOURPX_SENDER_CITY=
FOURPX_SENDER_DISTRICT=
FOURPX_SENDER_STREET=
FOURPX_SENDER_HOUSE_NUMBER=
FOURPX_RETURN_DOMESTIC_FIRST_NAME=
FOURPX_RETURN_DOMESTIC_LAST_NAME=
FOURPX_RETURN_DOMESTIC_COMPANY=
FOURPX_RETURN_DOMESTIC_PHONE=
FOURPX_RETURN_DOMESTIC_EMAIL=
FOURPX_RETURN_DOMESTIC_POST_CODE=
FOURPX_RETURN_DOMESTIC_COUNTRY=CN
FOURPX_RETURN_DOMESTIC_STATE=
FOURPX_RETURN_DOMESTIC_CITY=
FOURPX_RETURN_DOMESTIC_DISTRICT=
FOURPX_RETURN_DOMESTIC_STREET=
FOURPX_RETURN_DOMESTIC_HOUSE_NUMBER=
FOURPX_RETURN_OVERSEAS_FIRST_NAME=
FOURPX_RETURN_OVERSEAS_LAST_NAME=
FOURPX_RETURN_OVERSEAS_COMPANY=
FOURPX_RETURN_OVERSEAS_PHONE=
FOURPX_RETURN_OVERSEAS_EMAIL=
FOURPX_RETURN_OVERSEAS_POST_CODE=
FOURPX_RETURN_OVERSEAS_COUNTRY=
FOURPX_RETURN_OVERSEAS_STATE=
FOURPX_RETURN_OVERSEAS_CITY=
FOURPX_RETURN_OVERSEAS_DISTRICT=
FOURPX_RETURN_OVERSEAS_STREET=
FOURPX_RETURN_OVERSEAS_HOUSE_NUMBER=

# PayPal (sandbox)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=

# Cryptomus (cryptocurrency payments)
CRYPTOMUS_MERCHANT_UUID=
CRYPTOMUS_PAYMENT_KEY=
CRYPTOMUS_PAYOUT_KEY=
CRYPTOMUS_CURRENCY=USD
CRYPTOMUS_TEST=true

# OAuth credentials. Use exact HTTPS callback URLs in production and keep
# client secrets out of source control.
# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Facebook OAuth Credentials
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# AI support chat. Chat replies can use OpenAI or DeepSeek (set AI_CHAT_PROVIDER
# accordingly); knowledge embeddings always use OpenAI, so OPENAI_API_KEY is
# required for the knowledge base either way.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AI_CHAT_ENABLED=true
# Optional bidirectional English/Chinese translation for support conversations.
AI_CHAT_TRANSLATION_ENABLED=false
AI_CHAT_PROVIDER=openai
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_EMBEDDING_MODEL=text-embedding-3-small

# External support-chat API and Telegram bridge.
# Generate long random values and keep them out of source control.
AI_CHAT_API_TOKEN=
AI_CHAT_TELEGRAM_LINK_TTL=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TIMEOUT=10
# Telegram chat ID for the internal support group or operator chat.
TELEGRAM_SUPPORT_CHAT_ID=
# Comma-separated Telegram user IDs allowed to reply to support notifications.
TELEGRAM_SUPPORT_USER_IDS=

# WeCom WeChat Customer Service API.
WECOM_CORP_ID=
WECOM_KF_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_OPEN_KFID=
WECOM_TIMEOUT=10
AI_CHAT_WECOM_HISTORY_LIMIT=10

# WeCom self-built application that notifies staff about website support
# conversations and relays their replies back to the customer.
WECOM_APP_AGENT_ID=
WECOM_APP_SECRET=
# Comma-separated WeCom user IDs of support staff.
WECOM_APP_SUPPORT_USER_IDS=
# Optional: override the app callback credentials. Defaults reuse the
# customer-service callback token and EncodingAESKey above.
WECOM_APP_CALLBACK_TOKEN=
WECOM_APP_ENCODING_AES_KEY=

# Feishu self-built app that notifies staff about website support
# conversations and relays their replies back to customers.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Verification Token from the Feishu event-subscription settings.
FEISHU_VERIFICATION_TOKEN=
# Optional Encrypt Key. Leave empty to use token-only callback validation.
FEISHU_ENCRYPT_KEY=
FEISHU_TIMEOUT=10
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
# Comma-separated Feishu staff open_id values allowed to reply.
FEISHU_SUPPORT_OPEN_IDS=
