APP_NAME=InkPavo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8080
VITE_PORT=5173

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240
MEDIA_QUEUE_CONNECTION=database
MEDIA_QUEUE=default
QUEUE_CONVERSIONS_BY_DEFAULT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — dev: "log" (writes to storage/logs/laravel.log)
#        prod: "smtp" + fill DirectMail credentials below
# Docs: https://help.aliyun.com/document_detail/29442.html
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# DirectMail (Aliyun) — required when MAIL_MAILER=smtp in production
# MAIL_SCHEME=smtps
# MAIL_HOST=smtpdm.aliyun.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Intercom live chat (optional — leave empty to disable)
INTERCOM_APP_ID=
INTERCOM_ENABLED=true

# PayPal (sandbox)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD

# Cryptomus (cryptocurrency payments)
CRYPTOMUS_MERCHANT_UUID=
CRYPTOMUS_PAYMENT_KEY=
CRYPTOMUS_PAYOUT_KEY=
CRYPTOMUS_CURRENCY=USD
CRYPTOMUS_TEST=true

# OAuth credentials. Use exact HTTPS callback URLs in production and keep
# client secrets out of source control.
# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Facebook OAuth Credentials
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
