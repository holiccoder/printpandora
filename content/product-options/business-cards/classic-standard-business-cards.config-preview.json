  "faq": [
    {
      "question": "What are the exact dimensions?",
      "answer": "Standard and square sizes are available. Standard size is 3.5\" x 2.0\" and square size is 2.16\" x 3.3\".",
      "sort_order": 1,
      "is_active": true
    },
    {
      "question": "How thick is the paper?",
      "answer": "We start at premium and go all the way to extra fancy. Original thickness starts at 16pt, super starts at 18pt, luxe is 32pt, and cotton is 17pt.",
      "sort_order": 2,
      "is_active": true
    },
    {
      "question": "Can I print on both sides?",
      "answer": "Yes. All of our custom business cards can be printed full-colour on both sides at no extra cost.",
      "sort_order": 3,
      "is_active": true
    },
    {
      "question": "Will my colours print accurately?",
      "answer": "We print in CMYK. Designs created in RGB will be auto-converted, which can shift bright tones slightly.",
      "sort_order": 4,
      "is_active": true
    },
    {
      "question": "What file format should I upload?",
      "answer": "PDF (preferred), PNG, or JPG at 300 dpi or higher. Include bleed on every edge.",
      "sort_order": 5,
      "is_active": true
    },
    {
      "question": "How long does delivery take?",
      "answer": "Standard delivery takes 3–5 working days. Next Day Delivery is available on selected products before 12pm.",
      "sort_order": 6,
      "is_active": true
    }
  ],
